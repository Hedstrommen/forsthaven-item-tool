<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Domain layer holds pure business rules. It must never reference any
       other project or framework, so the rules stay testable and portable. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FrosthavenItemTool.Domain</RootNamespace>
  </PropertyGroup>

</Project>
